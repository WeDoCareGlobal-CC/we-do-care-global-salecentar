# Admin key must be long, random, private. Never commit real credentials.
HERMES_ADMIN_API_KEY=
X402_HOST=127.0.0.1
X402_NETWORK=base-sepolia
X402_SETTLE_MODE=simulate
X402_LEDGER_DB=./hermes-ledger.db
# Set only for controlled test deployments; not for accepting real funds.
X402_ALLOW_PUBLIC_SIMULATION=false
# Production: configure wallet and CDP facilitator secrets securely
X402_PRIVATE_KEY=
CDP_API_KEY_ID=
CDP_SECRET_KEY=
