# EXAMPLE ONLY. Replace staging.example.org and certificate paths before use.
# Run the Node integration server on 127.0.0.1:3101 with an isolated staging database.
# This configuration is not installed by this commit.
server {
    listen 443 ssl http2;
    server_name staging.example.org;
    ssl_certificate /etc/letsencrypt/live/staging.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/staging.example.org/privkey.pem;
    root /srv/salecentar-v2/dist-v2;
    index v2.html;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location /api/v2/ {
        proxy_pass http://127.0.0.1:3101;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 30s;
        add_header Cache-Control "no-store" always;
    }
    location / {
        try_files $uri $uri/ /v2.html;
    }
}
