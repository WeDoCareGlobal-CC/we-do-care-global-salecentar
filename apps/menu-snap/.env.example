# Server only. Never commit real secrets.
GEMINI_API_KEY=
DATABASE_URL=postgresql://menusnap:CHANGE_ME@127.0.0.1:5432/menusnap
PG_SSL=false
ADMIN_BOOTSTRAP_KEY=
AI_DAILY_LIMIT=30
IMAGE_STORAGE_DIR=./private-images
MENU_SNAP_PRICE_CENTS=14900
PORT=3000
NODE_ENV=development

# Menu Snap -> SaleCentar integration (same 32+ char secret as receiver)
SALECENTAR_SYNC_URL=http://127.0.0.1:3101/sync/menu-snap
SALECENTAR_MENU_SNAP_SECRET=replace-with-long-random-secret

# Central SaleCentar login (server-to-server; never expose module secret to browser)
SALECENTAR_AUTH_URL=http://127.0.0.1:4300
SALECENTAR_MENU_SNAP_SECRET=replace-with-unique-random-32-plus-character-secret
